# Add pyenv executable to PATH by running
# the following interactively:

set -Ux PYENV_ROOT $HOME/.pyenv
set -U fish_user_paths $PYENV_ROOT/bin $fish_user_paths

# Load pyenv automatically by appending
# the following to ~/.config/fish/config.fish:

pyenv init - | source

# vim not vi for awesome .vimrc
alias vi vim
#docker ps
alias dps "docker ps --format '{{.Names}} | {{.Ports}}'"
alias dpsp "docker ps --format '{{.Ports}}' | sort"
alias gemini "npx https://github.com/google-gemini/gemini-cli"
#Upgrade Docker Compose
alias dockerupgrade 'docker compose down ; docker compose pull ; docker compose up -d ; docker image prune -f'
# Claude Progress
alias progress '/home/dennis/Documents/Programming/Python/claude-progress/claude_progress.py'
# Opencode Clear
alias ocode 'opencode ; clear'
alias ocodemouse 'OPENCODE_DISABLE_MOUSE=1 opencode --dangerously-skip-permissions ;  clear'
alias btm 'btm --theme default-light'
alias opendirs 'sudo find . -type d -exec chmod 777 "{}" \;'
alias openfiles 'sudo find . -type f -exec chmod 666 "{}" \;'

# $EDITOR for glow
set -x EDITOR /usr/bin/vim
fish_add_path /home/dennis/.pixi/bin

# Conda
fish_add_path /home/dennis/miniconda3/bin

#Powerline Prompt
function fish_prompt
  powerline shell left
end

