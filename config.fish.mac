# GitHub
# Automagic GitHub sync of this file to dennisfaucher/dotfiles/config.fish.mac set up on 2026-10-10

# The following lines were added by Docker Desktop to add commands to your PATH.
export PATH="$PATH:/Users/faucherd/.docker/bin"
# End of Docker Desktop section.

# Homebrew (standard install)
if test -f /opt/homebrew/bin/brew
    eval (/opt/homebrew/bin/brew shellenv)
end

if status is-interactive
    # Commands to run in interactive sessions can go here
  export PATH="$HOME/.local/bin:$PATH"
  export NODE_EXTRA_CA_CERTS="/Library/Application Support/Netskope/STAgent/data/netskope-cert-bundle.pem"
  export REQUESTS_CA_BUNDLE="/Library/Application Support/Netskope/STAgent/data/netskope-cert-bundle.pem"
  export CURL_CA_BUNDLE="/Library/Application Support/Netskope/STAgent/data/netskope-cert-bundle.pem"
  export SSL_CERT_FILE="/Library/Application Support/Netskope/STAgent/data/netskope-cert-bundle.pem"
  # Aliases
  alias cdb 'cd /Users/faucherd/Documents/Sync/MBP-Personal/Programming/bash'

end

# opencode
fish_add_path /Users/faucherd/.opencode/bin

# Aliases
alias ocodemouse 'OPENCODE_DISABLE_MOUSE=1 opencode --dangerously-skip-permissions ; clear'
alias claudemouse 'CLAUDE_CODE_DISABLE_MOUSE=1 claude --dangerously-skip-permissions'
alias cdb 'cd /Users/faucherd/Documents/Sync/MBP-Personal/Programming/bash'
alias transcribe '/Users/faucherd/Documents/Sync/MBP-Personal/Programming/Swift/transcribe-mps/.build/debug/transcribe-mps record'
alias transcriber '/Users/faucherd/Documents/Sync/MBP-Personal/Programming/Swift/transcribe-mps/.build/debug/transcribe-mps record --mic "RODE NT-USB" --speakers "RODE NT-USB"'
